#Fig 3B
#Relating states to public data
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

BiocManager::install("GSVA")
library(GSVA)
library(survival)

#TCGA
TCGA <- read.table(file='genomicMatrix',sep="\t", stringsAsFactors=FALSE, header=TRUE)
rownames(TCGA) <- TCGA[,1]
TCGA<-TCGA[,-1]

TCGA_clinical <- read.table(file='clinical_data',sep="\t", stringsAsFactors=FALSE, header=TRUE)
rownames(TCGA_clinical) <- TCGA_clinical[,1]
TCGA_clinical<-TCGA_clinical[,-1]

stateSignatures<-read.table(file='clusterMarkers.txt',sep="\t",header=TRUE)
geneSet<-list(stateSignatures$State1,stateSignatures$State2,stateSignatures$State3,stateSignatures$State4,stateSignatures$State5,stateSignatures$State6)
geneSet[[6]]<-geneSet[[6]][1:42]

### 3065 ###
names(geneSet)<-c('State1','State2','State3','State4','State5','State6')

#Survival analysis
colnames(TCGA)<-gsub('\\.','-',colnames(TCGA))

idx<-which(rownames(TCGA_clinical) %in% colnames(TCGA))
TCGA_clinical<-TCGA_clinical[idx,]
idx<-which(is.na(TCGA_clinical[,21]))
TCGA_clinical<-TCGA_clinical[-idx,]

idx<-which(colnames(TCGA) %in% rownames(TCGA_clinical))
TCGA<-TCGA[,idx]
ssGSEA<-gsva(expr=as.matrix(TCGA),gset.idx.list = geneSet,method='ssgsea') #only on those with survival time

TCGA_clinical[,25]<-gsub('LIVING',1,TCGA_clinical[,25])
TCGA_clinical[,25]<-gsub('DECEASED',2,TCGA_clinical[,25])
TCGA_clinical[,25]<-as.numeric(TCGA_clinical[,25])

TCGA_clinical[,78]<-gsub('FEMALE',2,TCGA_clinical[,78])
TCGA_clinical[,78]<-gsub('MALE',1,TCGA_clinical[,78])
TCGA_clinical[,78]<-as.numeric(TCGA_clinical[,78])

ssGSEA<-t(ssGSEA)
survivalObjTCGA<-merge(ssGSEA,TCGA_clinical[,c(25,21,54,78)],by='row.names')
rownames(survivalObjTCGA)<-survivalObjTCGA[,1]
survivalObjTCGA<-survivalObjTCGA[,-1]
colnames(survivalObjTCGA)<-c('State1','State2','State3','State4','State5','State6','status','time','age','gender')

par(mfrow = c(3,2),
    oma = c(5, 4, 0, 0) + 0.1,
    mar = c(2.2, 1.8, 1.5, 0) + 1)

#state1
survivalObjTCGA <- survivalObjTCGA[order(survivalObjTCGA[,1],decreasing=FALSE),]
state1.cox <- coxph(Surv(time, status) ~ State1, data = survivalObjTCGA)
state1.pred <- predict(state1.cox, type = "risk", se.fit = T)

xstate1 <- 1:length(survivalObjTCGA[,1])
hrstate1 <- state1.pred$fit
highstate1 <- hrstate1 + 2*state1.pred$se.fit
lowstate1 <- hrstate1 - 2*state1.pred$se.fit

plot(xstate1, hrstate1, type = "n", ylim = c(0.5, 1.7), xaxs="i", xaxt = "n", cex.axis=1.5)
polygon(c(xstate1, rev(xstate1)), c(lowstate1, rev(highstate1)), col = "#87b9e8",border=NA)
lines(xstate1, hrstate1, lwd = 2)

