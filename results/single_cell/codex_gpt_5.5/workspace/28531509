library(Seurat)

# Fig 2A
combinedMatrix<-read.table(file='combinedMatrix.txt', header=TRUE, sep="\t",stringsAsFactors = FALSE)
rownames(combinedMatrix)<-combinedMatrix[,1]
combinedMatrix<-combinedMatrix[,-1]
G=read.table(file='mart_export.txt',header=TRUE,sep="\t",stringsAsFactors=FALSE);
idx<-match(colnames(combinedMatrix)[1:33538],G$Gene.stable.ID)
colnames(combinedMatrix)[1:33538]<-G$Gene.name[idx]
combinedMatrix<-combinedMatrix[,!duplicated(colnames(combinedMatrix))]
states<-read.table(file='expMatNoGenes9jan.txt',header=TRUE, sep="\t", stringsAsFactors = FALSE)
rownames(states)<-states[,1]
states<-states[,-1]
states[,3]<-c(1, 5, 3, 2, 6, 4, states[,3])[match(states[,3], c(1, 2, 3, 4, 5, 6, states[,3]))]
combinedMatrix<-merge(combinedMatrix,states[,3,drop=FALSE],by='row.names')
rownames(combinedMatrix)<-combinedMatrix[,1]
combinedMatrix<-combinedMatrix[,-1]
data<-as.data.frame(t(combinedMatrix[combinedMatrix$days!=0,1:33425]))

U3065MG<-CreateSeuratObject(counts = data, min.cells = 3,min.features =500,project = 'Non_treatment',meta.data = combinedMatrix[,33426:33428])
U3065MG <- SCTransform(U3065MG, verbose = FALSE)

data('cc.genes')
cc.genes
U3065MG <- CellCycleScoring(object = U3065MG, s.features = cc.genes$s.genes, g2m.features = cc.genes$g2m.genes, 
                          set.ident = TRUE)
U3065MG@meta.data$CC.Difference <- U3065MG@meta.data$S.Score - U3065MG@meta.data$G2M.Score
U3065MG.cellcyclemitigated <- ScaleData(object = U3065MG, vars.to.regress = "CC.Difference", display.progress = TRUE,features = all.genes)
U3065MG.cellcyclemitigated <- RunPCA(U3065MG.cellcyclemitigated, verbose = FALSE)
U3065MG.cellcyclemitigated <- RunUMAP(U3065MG.cellcyclemitigated, dims = 1:30, verbose = FALSE)

umap<-DimPlot(U3065MG.cellcyclemitigated,reduction = "umap",group.by = 'states')

