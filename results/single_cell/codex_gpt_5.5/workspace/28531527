library(networkD3)
library(Seurat)
library(GSVA)

#Fig 4A-B

## U3017MG ##
combinedMatrix3017<-read.table(file='./combinedMatrix3017.txt', header=TRUE, sep="\t",stringsAsFactors = FALSE)

G=read.table(file='/Users/idala384/Dropbox (UU)/Barcoding_project/comp/output/mart_export.txt',header=TRUE,sep="\t",stringsAsFactors=FALSE);
idx<-match(colnames(combinedMatrix3017)[1:36601],G$Gene.stable.ID)
colnames(combinedMatrix3017)[1:36601]<-G$Gene.name[idx]
combinedMatrix3017<-combinedMatrix3017[,!duplicated(colnames(combinedMatrix3017))]
stateVector3017<-read.table(file = 'stateVector_3017.txt',header=TRUE,sep="\t", stringsAsFactors = FALSE)
combinedMatrix3017<-merge(combinedMatrix3017,stateVector3017,by='row.names')
rownames(combinedMatrix3017)<-combinedMatrix3017[,1]
combinedMatrix3017<-combinedMatrix3017[,-1]

data<-as.data.frame(t(combinedMatrix3017[combinedMatrix3017$days!=0,1:34595]))

U3017MG<-CreateSeuratObject(counts = data, min.cells = 3,min.features =500,project = 'U3017MG',meta.data = combinedMatrix3017[,34596:34598])

#Quality control checks and opt. filtering
U3017MG[["percent.mt"]] <- PercentageFeatureSet(U3017MG, pattern = "^MT.")
VlnPlot(U3017MG, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
plot1 <- FeatureScatter(U3017MG, feature1 = "nCount_RNA", feature2 = "percent.mt")
plot2 <- FeatureScatter(U3017MG, feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
CombinePlots(plots = list(plot1, plot2))
U3017MG <- subset(U3017MG, subset = percent.mt < 10)

# Identify the 10 most highly variable genes
U3017MG <- FindVariableFeatures(U3017MG,do.plot=TRUE,display.progress = F)
top10 <- head(VariableFeatures(U3017MG), 10)
plot1 <- VariableFeaturePlot(U3017MG)
plot2 <- LabelPoints(plot = plot1, points = top10, repel = TRUE)
CombinePlots(plots = list(plot1, plot2))

# Normalization
U3017MG <- SCTransform(U3017MG, verbose = FALSE)

# Dimensionality reduction
U3017MG <- RunPCA(U3017MG, verbose = FALSE)
U3017MG <- RunUMAP(U3017MG, dims = 1:30, verbose = FALSE) #umap needs to be installed

U3017MG <- FindNeighbors(U3017MG, dims = 1:30, verbose = FALSE)
U3017MG <- FindClusters(U3017MG, verbose = TRUE)

plot1<-DimPlot(U3017MG,reduction = "umap", group.by = 'days')
plot2<-DimPlot(U3017MG,reduction = "umap", group.by = 'states3017.cluster')

# Cell cycle reduction
data('cc.genes')
cc.genes
U3017MG <- CellCycleScoring(object = U3017MG, s.features = cc.genes$s.genes, g2m.features = cc.genes$g2m.genes, 
                            set.ident = TRUE)
plot3<-DimPlot(U3017MG,reduction = "umap", group.by = 'Phase')

#cell cycle mitigated (to not remove difference between differentiated and stem cells)
U3017MG@meta.data$CC.Difference <- U3017MG@meta.data$S.Score - U3017MG@meta.data$G2M.Score
all.genes <- rownames(U3017MG)
U3017MG.cellcyclemitigated <- ScaleData(object = U3017MG, vars.to.regress = "CC.Difference", display.progress = TRUE,features = all.genes)

U3017MG.cellcyclemitigated <- SetIdent(object = U3017MG.cellcyclemitigated, value = U3017MG.cellcyclemitigated@meta.data$states3017.cluster)
U3017MG.markers <- FindAllMarkers(object = U3017MG.cellcyclemitigated,test.use='MAST')
top10 <- U3017MG.markers %>% group_by(cluster) %>% top_n(10,avg_logFC)
#DoHeatmap(object=U3017MG.cellcyclemitigated,features =top10$gene)

U3017MG.cellcyclemitigated <- RunPCA(U3017MG.cellcyclemitigated, verbose = FALSE)
U3017MG.cellcyclemitigated <- RunUMAP(U3017MG.cellcyclemitigated, dims = 1:30, verbose = FALSE)

plot3<-DimPlot(U3017MG.cellcyclemitigated,reduction = "umap",group.by = 'states3017.cluster')

